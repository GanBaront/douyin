[{"comment_id": "7677534503341966129", "create_time": 1787565301, "ip_location": "", "aweme_id": "7676308909367266612", "content": "当千年非遗的璀璨火花在无垠宇宙中绽放，那种跨越时空的浪漫真的让人起鸡皮疙瘩！这不仅仅是技术的突破，更是我们文化自信的极致体现。看着传统韵味在星辰大海间回响，真心为这份中式浪漫感到骄傲，太震撼了！", "is_author_digged": false, "is_folded": false, "is_hot": false, "user_buried": false, "user_digged": 0, "digg_count": "4", "user_id": "MS4wLjABAAAA8zvuSq8TNz_KkCOPz6WQu65ONNq9uXxpHJWHBDjCgb4Jsm353gv6kont8n7bwVur", "sec_uid": "MS4wLjABAAAA8zvuSq8TNz_KkCOPz6WQu65ONNq9uXxpHJWHBDjCgb4Jsm353gv6kont8n7bwVur", "short_user_id": "", "user_unique_id": "77002138633", "user_signature": "", "nickname": "向阳而生", "avatar": "https://p3-pc.douyinpic.com/aweme/100x100/aweme-avatar/tos-cn-i-0813c000-ce_o8ebLu0ePEHKA6nEi1nwHTBziWfAAEaABIlcA5.jpeg?from=2064092626", "sub_comment_count": "0", "last_modify_ts": 1794419805429}, {"comment_id": "7695230981746033418", "create_time": 1791685584, "ip_location": "", "aweme_id": "7676308909367266612", "content": "“锦”是古人对美好的想象，而“精”是古人抵达美好的方式。精益求精，只为了那花团锦簇。(每每看到九月的视频，眼眶就湿润了，或许中国人的魂，就藏在每一次的传承与精益求精[送心])", "is_author_digged": false, "is_folded": false, "is_hot": false, "user_buried": false, "user_digged": 0, "digg_count": "0", "user_id": "MS4wLjABAAAA5Ng92WZ3oD_IcsffzJv424VzB45hQQjLsaDra-265nE", "sec_uid": "MS4wLjABAAAA5Ng92WZ3oD_IcsffzJv424VzB45hQQjLsaDra-265nE", "short_user_id": "", "user_unique_id": "dy09s5xdbsh5", "user_signature": "", "nickname": "芸csthy", "avatar": "https://p3-pc.douyinpic.com/aweme/100x100/aweme-avatar/tos-cn-i-0813_osCBJAAAiDIAI3igzt9AUlcfOu6eC9A5LEAw82.jpeg?from=2064092626", "sub_comment_count": "0", "last_modify_ts": 1794419805429}, {"comment_id": "7676334612403192622", "create_time": 1787285930, "ip_location": "", "aweme_id": "7676308909367266612", "content": "古人的智慧实在太震撼了！一台大花楼织机，两千多个零件，两人上下配合，一日才织短短几厘米。没有电脑，仅凭丝线编成的花本，便能织出流光溢彩的云锦龙纹，一寸锦便抵得上一寸金。何其精巧，何其不易，老祖宗的手艺真的令人叹为观止。", "is_author_digged": false, "is_folded": false, "is_hot": false, "user_buried": false, "user_digged": 0, "digg_count": "365", "user_id": "MS4wLjABAAAAANtW8i10rWxjeDu0WkDRVWA0pSbIHofhPVoukpt74cvu4Jm1fqCylvLgXkGJpdqP", "sec_uid": "MS4wLjABAAAAANtW8i10rWxjeDu0WkDRVWA0pSbIHofhPVoukpt74cvu4Jm1fqCylvLgXkGJpdqP", "short_user_id": "", "user_unique_id": "84726668097", "user_signature": "", "nickname": "知旧期", "avatar": "https://p3-pc.douyinpic.com/aweme/100x100/aweme-avatar/tos-cn-i-0813_oIak5AYgM0AfRQgqLfX8CIAfvmzA0UQf2AMSDn.jpeg?from=2064092626", "sub_comment_count": "7", "last_modify_ts": 1794419805429}, {"comment_id": "7695417860222501669", "create_time": 1791729094, "ip_location": "", "aweme_id": "7676308909367266612", "content": "自从我见过现代织布机以后，再看我们的古代织布机，我就相信，西方的现代织布机就是从我们的织布机演变而来。", "is_author_digged": false, "is_folded": false, "is_hot": false, "user_buried": false, "user_digged": 0, "digg_count": "3", "user_id": "MS4wLjABAAAAvUh7ECUVf6PwMI-pyF88Umc2L68kbM0xmK68mU2026Y", "sec_uid": "MS4wLjABAAAAvUh7ECUVf6PwMI-pyF88Umc2L68kbM0xmK68mU2026Y", "short_user_id": "", "user_unique_id": "1273065468", "user_signature": "", "nickname": "锦绣谷", "avatar": "https://p3-pc.douyinpic.com/aweme/100x100/aweme-avatar/tos-cn-i-0813c001_oIJCAK2NBpqyfAAKEoG6eNwzghRACyAWiktpIA.jpeg?from=2064092626", "sub_comment_count": "0", "last_modify_ts": 1794419805429}, {"comment_id": "7682224465011852069", "create_time": 1788657268, "ip_location": "", "aweme_id": "7676308909367266612", "content": "如果把这些商业化，投入资金让这些非遗做下去，融入包，箱，衣物之类的，是不是可以成为中国的奢侈品", "is_author_digged": false, "is_folded": false, "is_hot": false, "user_buried": false, "user_digged": 0, "digg_count": "31", "user_id": "MS4wLjABAAAAsq4DAYA-7H9AB_3m1OZvIIFJFaV2EIEX7kEX03KeyPB_nyTp2gHDiw7DEbXQl2ZB", "sec_uid": "MS4wLjABAAAAsq4DAYA-7H9AB_3m1OZvIIFJFaV2EIEX7kEX03KeyPB_nyTp2gHDiw7DEbXQl2ZB", "short_user_id": "", "user_unique_id": "55977181346", "user_signature": "", "nickname": "Cheers！", "avatar": "https://p3-pc.douyinpic.com/aweme/100x100/aweme-avatar/tos-cn-i-0813c000-ce_o80vdAfrQOACrIQVFXLeJFgfUAyALyIp7AGjBx.jpeg?from=2064092626", "sub_comment_count": "7", "last_modify_ts":