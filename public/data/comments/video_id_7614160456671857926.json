g_count": "20", "user_id": "MS4wLjABAAAANjV5jsjQiRaJHDBAob9JeZxky-d9UF48wa37T6JuAJA", "sec_uid": "MS4wLjABAAAANjV5jsjQiRaJHDBAob9JeZxky-d9UF48wa37T6JuAJA", "short_user_id": "", "user_unique_id": "174961664", "user_signature": "", "nickname": "~多比", "avatar": "https://p3-pc.douyinpic.com/aweme/100x100/aweme-avatar/tos-cn-i-0813c001_oUCNAa0tdFFAAADAIpEDuhf2QAKegUcIACoJX9.jpeg?from=2064092626", "sub_comment_count": "0", "last_modify_ts": 1794419541536}, {"comment_id": "7615228702096425755", "create_time": 1773058602, "ip_location": "", "aweme_id": "7614160456671857926", "content": "用最优美的舞蹈，向全世界讲述中国故事。", "is_author_digged": false, "is_folded": false, "is_hot": false, "user_buried": false, "user_digged": 0, "digg_count": "7", "user_id": "MS4wLjABAAAAfdkre8K1Oc1dGIu2NW-b8aZbGG5QnNxS4SrNkp0pxuEJV-QxaEMcrgHJV7GDJeKO", "sec_uid": "MS4wLjABAAAAfdkre8K1Oc1dGIu2NW-b8aZbGG5QnNxS4SrNkp0pxuEJV-QxaEMcrgHJV7GDJeKO", "short_user_id": "", "user_unique_id": "25225455106", "user_signature": "", "nickname": "用户1229282947319", "avatar": "https://p3-pc.douyinpic.com/aweme/100x100/aweme-avatar/aweme_default_avatar.png.jpeg?from=2064092626", "sub_comment_count": "1", "last_modify_ts": 1794419541536}, {"comment_id": "7615444620416205617", "create_time": 1773108876, "ip_location": "", "aweme_id": "7614160456671857926", "content": "风动芦苇，鹤舞人间🌾。这段与丹顶鹤共舞的朝鲜族舞，把东方美学的灵动与温柔都拍出来了。\n原来最难的舞步，是向自然学来的诗意，每一帧都像在看一幅流动的水墨画，太治愈了！", "is_author_digged": false, "is_folded": false, "is_hot": false, "user_buried": false, "user_digged": 0, "digg_count": "7", "user_id": "MS4wLjABAAAAUa8IRAfmd7zENVsl70Yj4ZqlIIVclhKOARPTmSlddlw", "sec_uid": "MS4wLjABAAAAUa8IRAfmd7zENVsl70Yj4ZqlIIVclhKOARPTmSlddlw", "short_user_id": "", "user_unique_id": "ririyao81972", "user_signature": "", "nickname": "我是我是大石榴", "avatar": "https://p3-pc.douyinpic.com/aweme/100x100/aweme-avatar/tos-cn-avt-0015_8f292bb68b155cb07a7d7eb32c612e03.jpeg?from=2064092626", "sub_comment_count": "0", "last_modify_ts": 1794419541536}, {"comment_id": "7615240594948440869", "create_time": 1773061371, "ip_location": "", "aweme_id": "7614160456671857926", "content": "朝鲜族鹤舞身姿舒展、气韵灵动，体现了朝鲜族人民质朴、温和、向善的民族气质，真心希望更多人走进延边、走近朝鲜族文化，亲身感受这份独有的浪漫与底蕴！", "is_author_digged": false, "is_folded": false, "is_hot": false, "user_buried": false, "user_digged": 0, "digg_count": "1", "user_id": "MS4wLjABAAAA2KtZkdtAi5KbnAkLYZU6D_76w8vXmPbDpdnusDM6eJtoh6B8Yad1TIVQpDu3lU46", "sec_uid": "MS4wLjABAAAA2KtZkdtAi5KbnAkLYZU6D_76w8vXmPbDpdnusDM6eJtoh6B8Yad1TIVQpDu3lU46", "short_user_id": "", "user_unique_id": "44690245459", "user_signature": "", "nickname": "YJ0324", "avatar": "https://p3-pc.douyinpic.com/aweme/100x100/aweme-avatar/aweme_default_avatar.png.jpeg?from=2064092626", "sub_comment_count": "0", "last_modify_ts": 1794419541536}, {"comment_id": "7614196510498472741", "create_time": 1772818279, "ip_location": "", "aweme_id": "7614160456671857926", "content": "有点好奇朝鲜族的人看韩剧是不是很方便", "is_author_digged": false, "is_folded": false, "is_hot": false, "user_buried": false, "user_digged": 0, "digg_count": "73", "user_id": "MS4wLjABAAAApzIRLhifcTwFauJ75exEZdyZkYyddHYlNb3iwOX9Rb8Nk-jl-kF-fYxmzNUK1FTs", "sec_uid": "MS4wLjABAAAApzIRLhifcTwFauJ75exEZdyZkYyddHYlNb3iwOX9Rb8Nk-jl-kF-fYxmzNUK1FTs", "short_user_id": "", "user_unique_id": "80905981912", "user_signature": "", "nickname": "天降小慧星", "avatar": "https://p3-pc.douyinpic.com/aweme/100x100/aweme-avatar/tos-cn-avt-0015_82eb55af970f24c09cbff6ebc1c0c20b.jpeg?from=2064092626", "sub_comment_count": "4", "last_modify_ts": 1794419541536}, {"comment_id": "7614192870019154703", "create_time": 1772817433, "ip_location": "", "aweme_id": "7614160456671857926", "content": "鹤鹤鹤\n曲项向天歌\n[躺平][躺平][躺平]", "is_author_digged": false, "is_folded": false, "is_hot": false, "user_buried": false, "user_digged": 0, "digg_count": "3", "user_id": "MS4wLjABAAAAJNgTeHR_VbDcZI8is05AyQjWwXg1evCziwSdFtwaOvIO1hx8bO7Exinh7ycBqqFd", "sec_uid": "MS4wLjABAAAAJNgTeHR_VbDcZI8is05AyQjWwXg1evCziwSdFtwaOvIO1hx8bO7Exinh7ycBqqFd", "short_user_id": "", "user_un