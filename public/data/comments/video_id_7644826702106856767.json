g_count": "5", "user_id": "MS4wLjABAAAA3GYdABM2Jp_jYnHRbef6jfjL6sBkVeG29drj55GVnAJ1h-S5cqQA4w_lAn_P1bKT", "sec_uid": "MS4wLjABAAAA3GYdABM2Jp_jYnHRbef6jfjL6sBkVeG29drj55GVnAJ1h-S5cqQA4w_lAn_P1bKT", "short_user_id": "", "user_unique_id": "62726973231", "user_signature": "", "nickname": "脆脆鲨脆脆", "avatar": "https://p3-pc.douyinpic.com/aweme/100x100/aweme-avatar/tos-cn-i-0813c001_o4D1kIAWIIX8rEACffiDrGJIVQQZMjAeAAfLE2.jpeg?from=2064092626", "sub_comment_count": "0", "last_modify_ts": 1794420512334}, {"comment_id": "7649315446550397746", "create_time": 1780995040, "ip_location": "", "aweme_id": "7644826702106856767", "content": "所以说西施肯定不是一个病号，而是身体健康能歌善舞的有思想有抱负的高能量美女[泣不成声]", "is_author_digged": false, "is_folded": false, "is_hot": false, "user_buried": false, "user_digged": 0, "digg_count": "5", "user_id": "MS4wLjABAAAAXa082utMLFW4WyAptuZlWYMTV4pQKKVidIdcsISO-0Ilr2wBLiFw2R6F0ZY4-QuU", "sec_uid": "MS4wLjABAAAAXa082utMLFW4WyAptuZlWYMTV4pQKKVidIdcsISO-0Ilr2wBLiFw2R6F0ZY4-QuU", "short_user_id": "", "user_unique_id": "87571915645", "user_signature": "", "nickname": "困困小🐟", "avatar": "https://p3-pc.douyinpic.com/aweme/100x100/aweme-avatar/tos-cn-i-0813c001_ogAJ3ORlDQGHyZv4AbFAD0966CfeqAAIEygJAz.jpeg?from=2064092626", "sub_comment_count": "0", "last_modify_ts": 1794420512334}, {"comment_id": "7653687592495973172", "create_time": 1782013010, "ip_location": "", "aweme_id": "7644826702106856767", "content": "你可知道五月[流泪]", "is_author_digged": false, "is_folded": false, "is_hot": false, "user_buried": false, "user_digged": 0, "digg_count": "177", "user_id": "MS4wLjABAAAAUAucyA4uyawnXmIBP14vRMaYGVztWeUJTUVnD7_Rbw4", "sec_uid": "MS4wLjABAAAAUAucyA4uyawnXmIBP14vRMaYGVztWeUJTUVnD7_Rbw4", "short_user_id": "", "user_unique_id": "150665136", "user_signature": "", "nickname": "Sweet ❄️", "avatar": "https://p3-pc.douyinpic.com/aweme/100x100/aweme-avatar/tos-cn-avt-0015_7df3b5d864e225e4dc6f13ff82ba39c6.jpeg?from=2064092626", "sub_comment_count": "1", "last_modify_ts": 1794420512334}, {"comment_id": "7645006966523724584", "create_time": 1779991898, "ip_location": "", "aweme_id": "7644826702106856767", "content": "木屐，简称屐，是一种两齿木底鞋，走起来路来吱吱作响，适合在南方雨天、泥上行走。若鞋面为帛制成，则称为帛屐。牛皮制作则称作牛皮屐。木制底下是四个铁钉，耐磨、防滑。\n\n木屐是由中国人发明的，是隋唐以前，特别是汉朝时期的常见服饰。其名来自中古音“屐屉”，常称作木屐，使用于室外。后传入日本，在日本流行至今。\n\n木屐在中国，是汉服足衣的一种，是最古老的足衣。尧舜禹以后始服木屐。晋朝时，木屐有男方女圆的区别。汉晋隋唐时期的，木屐尤其普遍。在汉代，女性出嫁的时候会穿上彩色系带的木屐。南朝梁的贵族也常着高齿屐。南朝宋之时，贵族为了节俭也着木屐。杜牧诗云：“仆与足下齿同而道不同”。由木板与木屐带结合而成，木板的底面有两条突起的“齿”，目的是为了雨天便于泥上行走。屐是木履之下有齿者，又称木屐。江南以桐木为底，用蒲为鞋，麻穿其鼻。  除了两齿木屐以外，古代行军打仗时也会使用平底木屐，以防止脚部被带刺杂草划伤。不仅仅军人如此，平民也往往在路上穿着木屐，防止脚被带刺植物划伤。", "is_author_digged": false, "is_folded": false, "is_hot": false, "user_buried": false, "user_digged": 0, "digg_count": "31", "user_id": "MS4wLjABAAAAoZ9qRAG5C1lvpLHzHbNuOTbcpJ8uHl_U4Oa99g2g2MU", "sec_uid": "MS4wLjABAAAAoZ9qRAG5C1lvpLHzHbNuOTbcpJ8uHl_U4Oa99g2g2MU", "short_user_id": "", "user_unique_id": "Nnidexiaokea", "user_signature": "", "nickname": "言", "avatar": "https://p3-pc.douyinpic.com/aweme/100x100/aweme-avatar/tos-cn-i-0813_oUIMQABA7jwjAeGQ5LCneOR5e7nBPIAAGiIsEx.jpeg?from=2064092626", "sub_comment_count": "0", "last_modify_ts": 1794420512334}, {"comment_id": "7645625614791361286", "create_time": 1780135934, "ip_location": "", "aweme_id": "7644826702106856767", "content": "今天考试[泪奔]刚好考到西施响屐舞[色]", "is_author_digged": false, "is_folded": false, "is_hot": true, "user_buried": false, "user_digged": 0, "digg_count": "507", "user_id": "MS4wLjABAAAAmO1F1wcT2FFp0uaZUV1d0O7AW8uj23ybYc0mG_sT7TTXdfrvMYrQ9JTWUZo5ymLm", "sec_uid": "MS4wLjABAAAAmO1F1wcT2FFp0uaZUV1d0O7AW8uj23ybYc0mG_sT7TTXdfrvMYrQ9JTWUZo5ymLm", "short_user_id": "", "user_unique_id": "40543243491", "user_signature": "", "nickname": "欧神附体", "avatar": "https://p3-pc.douyinpic.com/aweme/100x100/aweme-avatar/tos-cn-avt-0015_2d8e3d59e006f8eba9475edee6017d31.jpeg?from=2064092626", "sub_comment_count": "0", "last_modify_ts": 1794420512334}, {"comment_id": "7647728316342338355", "create_time": 1780625507, "ip_location": "", "aweme_id": "7644826702106856767", "content"